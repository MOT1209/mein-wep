# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000

# No Docker / no system Postgres? Use the bundled PostgreSQL 17:
#   npm run db:start      (keeps running, prints the DATABASE_URL to paste here)
# Otherwise either of these works:
#   docker run -d --name chatapp-pg -p 5432:5432 \
#     -e POSTGRES_USER=chat -e POSTGRES_PASSWORD=chat -e POSTGRES_DB=chatapp postgres:16
#   or point it at your Supabase/Neon connection string.
DATABASE_URL=postgres://chat:chat@127.0.0.1:5433/chatapp

# Tests: set only to override the isolated database the test suite boots.
# NEVER point this at a database you care about — tests truncate their tables.
# TEST_DATABASE_URL=postgres://chat:chat@127.0.0.1:5434/chatapp_test

# MUST be at least 32 chars in production. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated allowlist of frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
MESSAGE_RATE_LIMIT_MAX=60

LOG_LEVEL=info
