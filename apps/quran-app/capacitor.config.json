{
  "appId": "com.rashid.quranpro",
  "appName": "Quran Pro",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "buildOptions": {
      "releaseType": "APK",
      "signingType": "apksigner"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#020617",
      "androidSplashResourceName": "splash",
      "showSpinner": true,
      "spinnerColor": "#059669"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#020617"
    }
  }
}
