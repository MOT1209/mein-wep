{% set root = "" %}
{% include "partials/site-head.njk" %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsClient }}" crossorigin="anonymous"></script>
    <style>
        .course-grid { display: grid; grid-template-columns: 1fr; gap: var(--s-4); margin-top: var(--s-6); }
        @media (min-width: 640px) { .course-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (min-width: 1024px) { .course-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
        .course-card { display: flex; flex-direction: column; gap: var(--s-3); background: var(--card); border: 1px solid var(--rule); border-radius: 14px; padding: var(--s-5); box-shadow: var(--lift); }
        .course-icon { font-size: 1.75rem; color: var(--signal); }
        .course-title { font-size: 1.25rem; }
        .course-desc { color: var(--ink-muted); margin: 0; }
        .course-progress { background: var(--card-sunk); height: 6px; border-radius: 3px; overflow: hidden; }
        .progress-bar { height: 100%; background: var(--signal); }
        .course-card .tags { display: flex; flex-wrap: wrap; gap: 6px; }
        .course-card .tags span { font-size: 0.75rem; padding: 1px 8px; border-radius: 999px; background: var(--card-sunk); border: 1px solid var(--rule); color: var(--ink-muted); }
        .course-card .btn { margin-top: auto; align-self: flex-start; }
        .lessons-state { grid-column: 1 / -1; text-align: center; color: var(--ink-muted); padding: var(--s-7) 0; }
    </style>
