<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Rashid Blog — Articles on web development, game development, AI/ML, and open-source projects. English &amp; العربية.">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://rashid-wep.vercel.app/blog/">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Blog | Rashid — Web Dev, Game Dev & AI">
    <meta property="og:description" content="Articles on web development, game development, AI integration, and open-source projects by Rashid (MOT1209).">
    <meta property="og:image" content="https://rashid-wep.vercel.app/images/og-image.png">
    <meta property="og:url" content="https://rashid-wep.vercel.app/blog/">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Blog | Rashid">
    <meta name="twitter:description" content="Articles on web dev, game development, AI, and open-source.">
    <meta name="twitter:image" content="https://rashid-wep.vercel.app/images/og-image.png">
    <title>Blog | Rashid — Web Dev, Game Dev & AI</title>
    <link rel="alternate" type="application/rss+xml" title="Rashid Blog RSS" href="/api/rss">
    {% set root = "../" %}
{% include "partials/site-head.njk" %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="../css/blog-post.css?v={{ site.cssVersion }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://rashid-wep.vercel.app/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://rashid-wep.vercel.app/blog/"
    }
  ]
}
</script>
</head>
<body class="site">
{% set activeNav = "blog" %}
{% include "partials/site-header.njk" %}

    <main class="site-main" id="main">
        <section class="blog-hero">
            <span class="hero-icon"><i aria-hidden="true" class="fas fa-pen-fancy"></i></span>
            <h1>Rashid <span class="highlight">Blog</span></h1>
            <p>Articles on web development, game development, AI/ML, and open-source projects.</p>
            <a href="/api/rss" class="rss-link"><i aria-hidden="true" class="fas fa-rss"></i> Subscribe via RSS</a>
            <div class="blog-stats" id="blog-stats">
                <span><i class="fas fa-newspaper"></i> <strong id="total-posts">0</strong> articles</span>
                <span><i class="fas fa-clock"></i> ~<strong id="total-read-time">0</strong> min total</span>
                <span><i class="fas fa-tags"></i> <strong id="total-categories">0</strong> categories</span>
            </div>
        </section>

        <div class="blog-controls">
            <div class="search-bar">
                <i class="fas fa-search"></i>
                <input type="text" id="search-input" placeholder="Search articles..." aria-label="Search articles">
            </div>
            <div class="filter-bar" id="filter-bar">
                <button class="filter-btn active" data-filter="all">All</button>
                <button class="filter-btn" data-filter="en">English</button>
                <button class="filter-btn" data-filter="ar">العربية</button>
            </div>
        </div>

        <section class="articles-section">
            <div class="articles-grid" id="articles-grid">
                <div class="no-results">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Loading articles...</p>
                </div>
            </div>
        </section>

        <section class="categories-section" id="categories-section">
            <h2><i class="fas fa-tags" ></i> Categories</h2>
            <div class="categories-grid" id="categories-grid">
                <div class="categories-empty">Loading...</div>
            </div>
        </section>
    </main>

    <script>
    (function() {
        var posts = [];
        var categories = {};
        var currentFilter = 'all';
        var currentSearch = '';

        function formatDate(dateStr) {
            var d = new Date(dateStr + 'T00:00:00Z');
            var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
            var monthsAr = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
            var isRtl = document.documentElement.dir === 'rtl';
            var m = isRtl ? monthsAr : months;
            return m[d.getUTCMonth()] + ' ' + d.getUTCDate() + ', ' + d.getUTCFullYear();
        }

        // Cards are built with textContent only: post data (including posts
        // from the admin CMS) can never become markup.
        function h(tag, cls, text) {
            var n = document.createElement(tag);
            if (cls) n.className = cls;
            if (text !== undefined && text !== null) n.textContent = String(text);
            return n;
        }
        function icon(name) {
            return h('i', 'fas fa-' + String(name || 'pen').replace(/[^a-z0-9-]/g, ''));
        }
        function langLabel(lang) {
            return lang === 'ar' ? h('span', 'card-lang ar', 'العربية') : h('span', 'card-lang en', 'English');
        }
        function safeColor(c, fallback) {
            return /^(#[0-9a-f]{3,8}|rgba?\([0-9.,\s%]+\))$/i.test(String(c || '')) ? c : fallback;
        }

        function renderGrid(items) {
            var grid = document.getElementById('articles-grid');
            grid.replaceChildren();
            if (items.length === 0) {
                var none = h('div', 'no-results');
                none.append(icon('search'), h('p', '', 'No articles match your criteria.'));
                grid.append(none);
                return;
            }
            items.forEach(function(p) {
                var card = h('a', 'article-card');
                card.href = encodeURIComponent(p.id) + '.html';
                var top = h('div', 'card-top');
                var ic = h('div', 'card-icon');
                ic.style.background = safeColor(p.iconBg, 'rgba(99,102,241,0.1)');
                ic.style.color = safeColor(p.iconColor, '#818cf8');
                ic.append(icon(p.icon));
                var info = h('div', 'card-info');
                info.append(langLabel(p.lang), h('h3', '', p.title), h('p', '', p.description));
                top.append(ic, info);
                var meta = h('div', 'card-meta');
                var date = h('span'); date.append(icon('calendar'), ' ' + formatDate(p.date));
                var time = h('span'); time.append(icon('clock'), ' ' + p.readTime + ' min');
                var tags = h('div', 'card-tags');
                (p.categories || []).forEach(function(c) { tags.append(h('span', 'card-tag', c)); });
                meta.append(date, time, tags);
                card.append(top, meta);
                grid.append(card);
            });
        }

        function applyFilters() {
            var filtered = posts.filter(function(p) {
                if (currentFilter !== 'all' && p.lang !== currentFilter) return false;
                if (currentSearch) {
                    var q = currentSearch.toLowerCase();
                    var match = p.title.toLowerCase().indexOf(q) !== -1 ||
                        p.description.toLowerCase().indexOf(q) !== -1 ||
                        p.categories.some(function(c) { return c.toLowerCase().indexOf(q) !== -1; });
                    if (!match) return false;
                }
                return true;
            });
            renderGrid(filtered);
        }

        function renderCategories() {
            var grid = document.getElementById('categories-grid');
            var keys = Object.keys(categories).sort();
            grid.replaceChildren();
            if (keys.length === 0) {
                grid.append(h('div', 'categories-empty', 'No categories yet.'));
                return;
            }
            var icons = {
                'Game Dev':'gamepad','AI & ML':'microchip','Web Dev':'globe','Backend':'database','Mobile':'mobile-screen','Web Design':'paintbrush','CSS':'code','Game AI':'robot','Flutter':'layer-group','LoRA':'microchip','Supabase':'database','PWA':'mobile-screen','Three.js':'cube','SEO':'rocket'
            };
            keys.forEach(function(cat) {
                var tag = h('div', 'category-tag');
                tag.append(icon(icons[cat] || 'tag'), h('h3', '', cat),
                    h('span', '', categories[cat] + ' article' + (categories[cat] !== 1 ? 's' : '')));
                grid.append(tag);
            });
        }

        function updateStats() {
            document.getElementById('total-posts').textContent = posts.length;
            var totalTime = posts.reduce(function(sum, p) { return sum + p.readTime; }, 0);
            document.getElementById('total-read-time').textContent = totalTime;
            document.getElementById('total-categories').textContent = Object.keys(categories).length;
        }

        function initFilterButtons() {
            var btns = document.querySelectorAll('.filter-btn');
            btns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    btns.forEach(function(b) { b.classList.remove('active'); });
                    this.classList.add('active');
                    currentFilter = this.getAttribute('data-filter');
                    applyFilters();
                });
            });
        }

        function initSearch() {
            var input = document.getElementById('search-input');
            var timer;
            input.addEventListener('input', function() {
                clearTimeout(timer);
                timer = setTimeout(function() {
                    currentSearch = input.value;
                    applyFilters();
                }, 200);
            });
        }

        // Posts written as files (posts.json) plus posts published from the
        // admin CMS (cms-posts.json, generated at build time), newest first.
        Promise.all([
            fetch('posts.json?_=' + Date.now()).then(function(r) { return r.json(); }),
            fetch('cms-posts.json?_=' + Date.now()).then(function(r) { return r.ok ? r.json() : []; }).catch(function() { return []; })
        ])
            .then(function(both) {
                var data = both[0].concat(both[1]);
                data.sort(function(a, b) { return a.date === b.date ? 0 : (a.date < b.date ? 1 : -1); });
                posts = data;
                categories = {};
                posts.forEach(function(p) {
                    p.categories.forEach(function(c) {
                        categories[c] = (categories[c] || 0) + 1;
                    });
                });
                updateStats();
                renderCategories();
                applyFilters();
            })
            .catch(function() {
                var grid = document.getElementById('articles-grid');
                var box = h('div', 'no-results');
                box.append(icon('exclamation-triangle'), h('p', '', 'Failed to load articles. Please try again later.'));
                grid.replaceChildren(box);
            });

        initFilterButtons();
        initSearch();
    })();
    </script>
{% include "partials/site-footer.njk" %}
    <script src="../js/site-nav.js?v={{ site.cssVersion }}" defer></script>
</body>
</html>
