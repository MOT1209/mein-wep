# Browser Automation Credentials
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# Google Account
GOOGLE_EMAIL=your_google_email@gmail.com
GOOGLE_PASSWORD=your_google_password

# GitHub Account
GITHUB_EMAIL=your_github_email@example.com
GITHUB_PASSWORD=your_github_password

# Hugging Face Account
HF_EMAIL=your_hf_email@example.com
HF_PASSWORD=your_hf_password
HF_TOKEN=your_hf_read_token

# General Settings
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=100
