{
  "name": "quran-pro",
  "version": "1.1.0",
  "type": "module",
  "description": "Quran Pro - القرآن الكريم | قراءة واستماع مع مزامنة سحابية",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "vite build --mode android",
    "sync:android": "npm run build:android && npx cap sync android",
    "release:android": "npm run sync:android && cd android && gradlew.bat bundleRelease",
    "test:supabase": "node scripts/supabase-integration-test.mjs",
    "preview": "vite preview"
  },
  "keywords": [
    "quran",
    "islam",
    "prayer",
    "recitation",
    "supabase"
  ],
  "author": "Rashid",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.28.0",
    "vite": "^8.2.0"
  }
}
