<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand colors for Quran Pro.

  Without this file the theme in styles.xml resolved @color/colorPrimary,
  colorPrimaryDark and colorAccent against the Capacitor/AppCompat library
  defaults (indigo #3F51B5 / #303F9F and pink #FF4081), so the splash, the
  status bar and the recents card showed colors unrelated to the app.

  Values match the web app: theme_color #059669 and background_color #020617
  in manifest.json, and the amber accent from icons/icon.svg.
-->
<resources>
    <color name="colorPrimary">#059669</color>
    <color name="colorPrimaryDark">#020617</color>
    <color name="colorAccent">#F59E0B</color>

    <!-- Splash background; keep in sync with manifest.json background_color. -->
    <color name="splashBackground">#020617</color>
</resources>
