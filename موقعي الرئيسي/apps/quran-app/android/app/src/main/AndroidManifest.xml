<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- screenOrientation="portrait": the Mushaf reader renders onto a fixed
             400x620 reference page and scales by min(availW/400, availH/620), so
             landscape collapses it toward the lower bound and the text becomes
             unreadable. manifest.json's "portrait-primary" does not apply to a
             Capacitor WebView — the lock has to be declared here. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- The Capacitor-template FileProvider was removed. It exposed
             <external-path path="."/> and <cache-path path="."/> — the whole
             external storage root and cache dir — with no consumer: the app
             registers zero Capacitor plugins (capacitor.plugins.json is []).
             Re-add it, scoped to a specific subdirectory, only if a plugin
             that needs file sharing (Camera/Filesystem/Share) is installed. -->
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
