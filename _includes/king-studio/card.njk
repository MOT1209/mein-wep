{#- One catalogue card, used on the homepage and the King Studio pages.
    Expects `project` and `root`; optional `locale` (default "en") and
    `cardHeading` (default h3, so catalogue pages with an h1 can use h2).
    Text comes from project.text[locale] and i18n[locale].studio. -#}
{%- set L = locale or "en" %}
{%- set S = i18n[L].studio %}
{%- set P = project.text[L] %}
{%- set detail = (root or "") ~ (site.translations.studio[L] | replace("king-studio/", "")) ~ project.detailUrl %}
<li class="ks-card" data-ks-item data-search="{{ project.searchText }}" data-platforms="{{ project.platforms | join('|') }}" data-status="{{ project.status }}">
  <a class="ks-card-icon" href="{{ detail }}" tabindex="-1" aria-hidden="true">
    {%- if project.image %}
    <img src="{{ root }}{{ project.image }}" alt="" loading="lazy" decoding="async" width="72" height="72">
    {%- else %}
    <span class="ks-monogram">{{ project.title | first }}</span>
    {%- endif %}
  </a>
  <div class="ks-card-body">
    <div class="ks-card-meta">
      {% include "king-studio/status.njk" %}
      {%- if P.category %}<span class="ks-category">{{ P.category }}</span>{% endif %}
    </div>
    <{{ cardHeading or "h3" }} class="ks-card-title"><a href="{{ detail }}">{{ project.title }}</a></{{ cardHeading or "h3" }}>
    <p class="ks-card-desc">{{ P.description }}</p>
    {%- if project.platforms | length %}
    <ul class="ks-platforms" aria-label="{{ S.platforms }}">
      {%- for pl in project.platforms %}<li dir="ltr">{{ pl }}</li>{% endfor %}
    </ul>
    {%- endif %}
    <div class="ks-card-actions">
      {%- if project.launchUrl %}<a class="ks-btn ks-btn-primary" href="{{ root }}{{ project.launchUrl }}">{{ S.play if project.type == 'Game' else S.open }}<span class="visually-hidden"> {{ project.title }}</span></a>{% endif %}
      <a class="ks-btn ks-btn-ghost" href="{{ detail }}">{{ S.details }}<span class="visually-hidden"> {{ S.detailsFor }} {{ project.title }}</span></a>
    </div>
  </div>
</li>
