{#
  Base page shell.

  Two modes, selected by the `legacyShell` front-matter flag:
   - Unset/false: inert passthrough — the template owns its entire HTML
     document.
   - `legacyShell: true` (index/about/contact/privacy/terms.njk): the shared site
     shell on css/tokens.css + css/site.css, with the same header, mobile
     menu and footer as every other secondary page
     (partials/site-header.njk, partials/site-footer.njk, js/site-nav.js).

  Front matter: title, metaDescription, canonical, ogDescription,
  metaKeywords, activeNav, headTop/headExtra (page <head> partials),
  showAdUnit, showCookieConsent, extraBodyScript, trailingJsonLd,
  noAds (skip the AdSense loader), showSettings (settings button in the header).
#}{%- if legacyShell -%}{% set root = "" %}<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ metaDescription }}">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ canonical }}">
    <link rel="alternate" hreflang="en" href="{{ canonical }}">
    <link rel="alternate" hreflang="x-default" href="{{ canonical }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ ogDescription or metaDescription }}">
    <meta property="og:image" content="https://rashid-wep.vercel.app/images/og-image.png">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:site_name" content="Rashid Portfolio">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ ogDescription or metaDescription }}">
    <meta name="twitter:image" content="https://rashid-wep.vercel.app/images/og-image.png">
    <meta name="keywords" content="{{ metaKeywords }}">
    <title>{{ title }}</title>
{%- if headTop %}
{% include headTop %}
{%- endif %}
{% include "partials/site-head.njk" %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'">
{%- if not noAds %}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsClient }}" crossorigin="anonymous"></script>
{%- endif %}
{%- if headExtra %}
{% include headExtra %}
{%- endif %}
</head>
<body class="site">
{% include "partials/site-header.njk" %}
    <main id="main" class="site-main">
{{ content | safe }}
    </main>
{%- if showAdUnit %}
    <div class="ad-slot">
        <ins class="adsbygoogle"
             style="display:block"
             data-ad-client="{{ site.adsClient }}"
             data-ad-slot="{{ site.adsSlot }}"
             data-ad-format="auto"
             data-full-width-responsive="true"></ins>
        <script>
             (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
    </div>
{%- endif %}
{% include "partials/site-footer.njk" %}
{%- if extraBodyScript %}
{% include extraBodyScript %}{% endif %}{% if showCookieConsent %}
<div id="cookie-consent" class="cookie-banner" role="region" aria-label="Cookie consent">
  <div class="cookie-content">
    <div class="cookie-text">
      <span>This site uses cookies for Google AdSense and analytics. By continuing, you accept our <a href="privacy.html">Privacy Policy</a> and <a href="terms.html">Terms of Service</a>.</span>
    </div>
    <div class="cookie-actions">
      <button id="cookie-decline" class="cookie-btn cookie-decline">Decline</button>
      <button id="cookie-accept" class="cookie-btn cookie-accept">Accept all</button>
    </div>
  </div>
</div>
<script src="js/cookie-consent.js?v=1.0"></script>
<script>CookieConsent.init();</script>
{%- endif %}
{%- if trailingJsonLd %}
{% include trailingJsonLd %}
{%- endif %}
<script src="js/site-nav.js?v={{ site.cssVersion }}" defer></script>
</body>
</html>
{% else %}{{ content | safe }}{%- endif -%}