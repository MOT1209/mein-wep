    <script>
        (function() {
            var form = document.getElementById('contact-form');
            if (!form) return;
            var lastSubmit = 0;
            form.addEventListener('submit', function(e) {
                if (!window.fetch) return;
                e.preventDefault();
                var now = Date.now();
                if (now - lastSubmit < 30000) {
                    var fb = document.getElementById('form-feedback');
                    fb.className = 'error';
                    fb.textContent = 'Please wait 30 seconds before sending another message.';
                    fb.style.display = 'block';
                    setTimeout(function() { fb.className = ''; fb.textContent = ''; fb.style.display = 'none'; }, 4000);
                    return;
                }
                var honeypot = document.getElementById('hp_website');
                if (honeypot && honeypot.value !== '') return;
                var feedback = document.getElementById('form-feedback');
                var submitBtn = form.querySelector('.btn-submit');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
                var data = {
                    name: document.getElementById('name').value.trim(),
                    email: document.getElementById('email').value.trim(),
                    subject: document.getElementById('subject').value.trim(),
                    message: document.getElementById('message').value.trim()
                };
                if (!data.name || !data.email || !data.message) {
                    feedback.className = 'error';
                    feedback.textContent = 'Please fill in all required fields.';
                    feedback.style.display = 'block';
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Send Message';
                    return;
                }
                lastSubmit = now;
                // Try Vercel API first, fallback to FormSubmit
                fetch('/api/contact', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                })
                .then(function(r) { return r.json(); })
                .then(function(resp) {
                    if (resp.success) {
                        feedback.className = 'success';
                        feedback.textContent = 'Message sent successfully! I will get back to you soon.';
                        feedback.style.display = 'block';
                        form.reset();
                    } else {
                        throw new Error(resp.error || 'Send failed');
                    }
                })
                .catch(function() {
                    // Fallback to FormSubmit
                    return fetch('https://formsubmit.co/ajax/zwnt45602@gmail.com', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(data)
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(fsData) {
                        if (fsData.success) {
                            feedback.className = 'success';
                            feedback.textContent = 'Message sent successfully! I will get back to you soon.';
                            feedback.style.display = 'block';
                            form.reset();
                        } else {
                            throw new Error('FormSubmit failed');
                        }
                    })
                    .catch(function() {
                        feedback.className = 'error';
                        feedback.textContent = 'Failed to send message. Please email me directly at zwnt45602@gmail.com.';
                        feedback.style.display = 'block';
                    });
                })
                .finally(function() {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Send Message';
                    setTimeout(function() { feedback.className = ''; feedback.textContent = ''; feedback.style.display = 'none'; }, 5000);
                });
            });
        })();
    </script>
