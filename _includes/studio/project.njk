{#- King Studio project detail page. Expects `root`, `locale`, `project`. -#}
{%- set L = locale or "en" %}
{%- set S = i18n[L].studio %}
{%- set P = project.text[L] %}
{%- set sec = project.section %}
<div class="ks">
<section class="ks-page-head">
  <div class="wrap">
{% include "studio/crumbs.njk" %}
  </div>
</section>
<article class="ks-section ks-detail">
  <div class="wrap">
    <header class="ks-detail-head">
      <div class="ks-detail-icon">
        {%- if project.image %}
        <img src="{{ project.image | link(root) }}" alt="{{ P.imageAlt }}" width="112" height="112" decoding="async">
        {%- else %}
        <span class="ks-monogram ks-monogram-lg" aria-hidden="true">{{ project.title | first }}</span>
        {%- endif %}
      </div>
      <div>
        <div class="ks-card-meta">
          {% include "king-studio/status.njk" %}
          {%- if P.category %}<span class="ks-category">{{ P.category }}</span>{% endif %}
        </div>
        <h1>{{ project.title }}</h1>
        <p class="ks-lede">{{ P.description }}</p>
      </div>
    </header>

    <div class="ks-card-actions ks-detail-actions">
      {%- if project.launchUrl %}<a class="ks-btn ks-btn-primary" href="{{ project.launchUrl | link(root) }}">{{ S.play if project.type == 'Game' else S.open }}</a>{% endif %}
      {%- if project.demoUrl %}<a class="ks-btn ks-btn-ghost" href="{{ project.demoUrl | link(root) }}" rel="noopener">{{ S.demo }}</a>{% endif %}
      {%- if project.downloadUrl %}<a class="ks-btn ks-btn-ghost" href="{{ project.downloadUrl | link(root) }}" download>{{ S.download }}{% if project.version %} <span class="ks-version" dir="ltr">v{{ project.version }}</span>{% endif %}</a>{% endif %}
      {%- if project.githubUrl %}<a class="ks-btn ks-btn-ghost" href="{{ project.githubUrl | link(root) }}" rel="noopener">{{ S.source }}</a>{% endif %}
      <a class="ks-btn ks-btn-ghost" href="{{ root }}{{ site.translations.studio[L] }}{{ sec }}/">{{ S.backTo[sec] }}</a>
    </div>
    {%- if not project.launchUrl and not project.demoUrl %}
    <p class="ks-note">{{ S.noBuild }}</p>
    {%- endif %}
    {%- if project.githubArchived %}
    <p class="ks-note">{{ S.archived }}</p>
    {%- endif %}

    {%- if P.paragraphs | length %}
    <div class="ks-long"{% if L != 'en' and not project.i18n[L].longDescription %} lang="en"{% if L == 'ar' %} dir="ltr"{% endif %}{% endif %}>
      {%- for para in P.paragraphs %}<p>{{ para }}</p>{% endfor %}
    </div>
    {%- endif %}

    {%- if project.gallery | length %}
    <section class="ks-gallery-wrap">
      <h2>{{ S.gallery }}</h2>
      <ul class="ks-gallery">
        {%- for g in project.gallery %}<li><img src="{{ g.url | link(root) }}" alt="{{ g.alt }}" loading="lazy" decoding="async"></li>{% endfor %}
      </ul>
    </section>
    {%- endif %}

    <div class="ks-detail-grid">
      {%- if P.features | length %}
      <section>
        <h2>{{ S.features }}</h2>
        <ul class="ks-features">
          {%- for f in P.features %}<li>{{ f }}</li>{% endfor %}
        </ul>
      </section>
      {%- endif %}
      <section>
        <h2>{{ S.factsTitle }}</h2>
        <dl class="ks-facts">
          <div><dt>{{ S.factType }}</dt><dd>{{ S.types[project.type] or project.type }}</dd></div>
          {%- if project.platforms | length %}<div><dt>{{ S.factPlatforms }}</dt><dd><span dir="ltr">{{ project.platforms | join(', ') }}</span></dd></div>{% endif %}
          {%- if project.technologies | length %}<div><dt>{{ S.factTech }}</dt><dd><span dir="ltr">{{ project.technologies | join(', ') }}</span></dd></div>{% endif %}
          <div><dt>{{ S.factStatus }}</dt><dd>{{ S.status[project.status] }}</dd></div>
          {%- if project.githubLanguage %}<div><dt>{{ S.factLanguage }}</dt><dd><span dir="ltr">{{ project.githubLanguage }}</span></dd></div>{% endif %}
          {%- if project.version %}<div><dt>{{ S.factVersion }}</dt><dd><span dir="ltr">{{ project.version }}</span></dd></div>{% endif %}
        </dl>
      </section>
    </div>
  </div>
</article>
</div>
