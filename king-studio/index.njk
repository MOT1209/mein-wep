{%- endif %}
      <a class="ks-link-quiet" href="../">&larr; Back to the portfolio</a>
    </div>
    <dl class="ks-hero-facts">
{%- for key, label in [["games", "Games"], ["apps", "Apps"], ["labs", "In the lab"]] %}{% if kingStudio.sections[key].projects | length %}
