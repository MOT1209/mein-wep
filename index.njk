      "sameAs": ["https://github.com/MOT1209"],
      "makesOffer": [
        {"@type":"Offer","itemOffered":{"@type":"Service","name":"Web Development","description":"Full-stack web platforms with Next.js & Supabase"}},
        {"@type":"Offer","itemOffered":{"@type":"Service","name":"AI Integration","description":"AI assistants, chatbots, and automation powered by Gemini & OpenRouter"}},
