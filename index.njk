    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Rashid — Full-Stack Developer & AI Engineer",
      "url": "https://rashid-wep.vercel.app",
      "description": "Full-stack developer and AI engineer portfolio. Building AI-powered platforms, 3D games, and open-source tools.",
