    <script src="js/gemini-config.js?v=1.0" defer></script>
    <script src="js/rashid-ai-v2.js?v=3.0" defer></script>

    <script>
    // Footer year.
    document.querySelectorAll('.copyright-year').forEach(function (el) {
      el.textContent = new Date().getFullYear();
    });

    // The rail and the mobile bar each carry a theme and settings button;
    // both drive the same handlers the modules bind to the primary ids.
    ['theme-toggle', 'settings-btn'].forEach(function (id) {
      var primary = document.getElementById(id);
      var twin = document.getElementById(id + '-rail');
      if (primary && twin) twin.addEventListener('click', function () { primary.click(); });
    });

    // Mark the rail link for the section currently in view.
    (function () {
      var links = Array.prototype.slice.call(document.querySelectorAll('.rail-nav a[href^="#"]'));
      if (!links.length || !('IntersectionObserver' in window)) return;
      var byId = {};
      links.forEach(function (a) { byId[a.getAttribute('href').slice(1)] = a; });
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          links.forEach(function (a) { a.classList.remove('is-active'); });
          var active = byId[entry.target.id];
          if (active) active.classList.add('is-active');
        });
      }, { rootMargin: '-40% 0px -55% 0px' });
      Object.keys(byId).forEach(function (id) {
        var section = document.getElementById(id);
        if (section) obs.observe(section);
      });
    })();

    // Hidden admin access: Ctrl+Shift+A (not publicly documented)
    document.addEventListener('keydown', function (e) {
      if (e.ctrlKey && e.shiftKey && e.key === 'A') { e.preventDefault(); window.open('admin/login.html', '_blank'); }
    });
    </script>

    </body>
