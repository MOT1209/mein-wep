        <button class="mobile-menu-close" id="mobile-menu-close" data-menu-close aria-label="Close menu"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        {% include "partials/nav-links.njk" %}
    </div>

    <div class="shell">

        <!-- Rail: identity, index, status -->
        <aside class="rail">
            <div class="rail-id">
                <a href="#intro" class="rail-name">Rashid<span class="dot">.</span></a>
                <span class="rail-role">Full-stack developer &amp; AI engineer</span>
            </div>

            <nav class="rail-nav" aria-label="Sections">
                {% include "partials/nav-links.njk" %}
            </nav>

            <div class="rail-foot">
                <div class="rail-status">
                    <span class="status-dot"></span>
                    <span>Last build {{ releases.updatedAt }}</span>
                </div>
                <div class="rail-actions">
